# ==============================
# Python / FastAPI .gitignore
# ==============================

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
.venv.bak/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# SQLite database
*.db
*.sqlite3

# Logs
*.log
logs/
*.pid

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# PyCharm / VSCode / other IDEs
.idea/
.vscode/
*.swp
*.swo

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# macOS / Windows
.DS_Store
Thumbs.db

# Docker
**/__pycache__/
.dockerignore
*.env
.env*
docker-compose.override.yml

# FastAPI specific
test.db
instance/
